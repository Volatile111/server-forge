{
  "appId": "com.tavernhost.clientmodmanager",
  "productName": "Mod Forge",
  "directories": {
    "output": "release"
  },
  "extraMetadata": {
    "name": "tavern-client-mod-manager",
    "productName": "Mod Forge",
    "version": "0.5.5",
    "main": "companion/main.js"
  },
  "files": [
    "companion/**",
    "dist/valheim-mods.js",
    "dist/zip.js",
    "dist/modscan.js",
    "dist/nexus.js",
    "dist/bepinex-config.js",
    "dist/modsync/**",
    "package.json"
  ],
  "asar": false,
  "win": {
    "target": "nsis",
    "icon": "companion/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mod Forge",
    "runAfterFinish": true,
    "installerIcon": "companion/icon.ico",
    "uninstallerIcon": "companion/icon.ico",
    "license": "LICENSE",
    "artifactName": "Mod-Forge-Setup-${version}.exe"
  },
  "publish": null
}
